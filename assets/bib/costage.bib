author = {Song, Junrong and Wan, Huanyi and Han, Lei and Gao, Yinghao and Yip, David and Tong, Xin},
title = {CoStage: An Embodied AI Co-Creation System for Children’s Performative Storytelling with Robots},
year = {2026},
