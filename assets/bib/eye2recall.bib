title = {Eye2Recall: Exploring Mixed-Initiative Reminiscence Activities via Gaze-Driven LLM Prompts for Older Adults: Eye2Recall: Fusing Gaze and LLMs for Mixed-Initiative Reminiscence with Older Adults},
